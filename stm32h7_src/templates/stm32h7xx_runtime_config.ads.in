--  Renames the crate's configuration package, whose name depends on the
--  profile, to the name the family's sources use. Generated by
--  patch-runtime.py for each profile.

pragma Restrictions (No_Elaboration_Code);
pragma Style_Checks (Off);

with $(profile_underscored)_Stm32h7xx_Config;

package STM32H7xx_Runtime_Config renames
  $(profile_underscored)_Stm32h7xx_Config;
