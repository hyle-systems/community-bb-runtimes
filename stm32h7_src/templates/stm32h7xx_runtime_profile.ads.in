pragma Restrictions (No_Elaboration_Code);
pragma Style_Checks (Off);

--  Which profile this crate is, for the few checks in the family's sources
--  that depend on it (System.BB.Parameters refuses the tasking-only options
--  in the light profile). Generated by patch-runtime.py from the manifest.

package STM32H7xx_Runtime_Profile is
   pragma Pure;

   Name        : constant String  := "$(profile)";
   Has_Tasking : constant Boolean := $(has_tasking);

end STM32H7xx_Runtime_Profile;
