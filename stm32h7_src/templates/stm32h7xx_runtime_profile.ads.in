--  Tells the family's sources which profile this crate is, for the few
--  checks that depend on it: System.BB.Parameters, for example, refuses
--  the tasking-only options in the light profile. Generated by
--  patch-runtime.py from the manifest.

pragma Restrictions (No_Elaboration_Code);
pragma Style_Checks (Off);

package STM32H7xx_Runtime_Profile is
   pragma Pure;

   Has_Tasking : constant Boolean := $(has_tasking);
   --  Only embedded propagates exceptions. A fault's handling then unwinds
   --  on the fault stack, so System.BB.Parameters sets a floor on its size.
   Has_Exception_Propagation : constant Boolean := $(has_exception_propagation);

end STM32H7xx_Runtime_Profile;
